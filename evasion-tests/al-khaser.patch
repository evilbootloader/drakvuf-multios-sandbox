--- a/al-khaser/Shared/Common.cpp
+++ b/al-khaser/Shared/Common.cpp
@@ -1,6 +1,76 @@
 #include "pch.h"
 #include "Common.h"
 
+/* The category running, how many checks it reported so far, and the detections: code and text */
+static UINT current_category = 0;
+static UINT checks_in_category = 0;
+static std::vector<UINT> detections, blocked;
+DWORD check_timeout_ms = 120 * 1000;
+
+/* An event named "al-khaser <code> <kind> <text>": its NtCreateEvent shows in a trace */
+static VOID trace_mark(UINT code, const TCHAR* kind, const TCHAR* text)
+{
+	std::basic_string<TCHAR> name = TEXT("al-khaser ") + std::to_wstring(code) + TEXT(" ") + kind +
+		TEXT(" ") + (text ? text : TEXT(""));
+
+	/* A backslash would make it a path */
+	std::replace(name.begin(), name.end(), TEXT('\\'), TEXT('/'));
+	name = name.substr(0, 200);
+	while (!name.empty() && name.back() == TEXT(' '))
+		name.pop_back();
+	HANDLE event = CreateEvent(NULL, FALSE, FALSE, name.c_str());
+	if (event)
+		CloseHandle(event);
+}
+
+static DWORD WINAPI exit_code_thread(LPVOID code)
+{
+	return (DWORD)(ULONG_PTR)code;
+}
+
+/* A thread that exits with code: its NtTerminateThread shows in a trace */
+static VOID trace_exit_code(UINT code)
+{
+	HANDLE thread = CreateThread(NULL, 0, exit_code_thread, (LPVOID)(ULONG_PTR)code, 0, NULL);
+	if (thread) {
+		WaitForSingleObject(thread, INFINITE);
+		CloseHandle(thread);
+	}
+}
+
+/* Shared with the check's thread, which may outlive run_check */
+struct check_job {
+	std::function<int()> check;
+	int result = 0;
+};
+
+static DWORD WINAPI check_thread(LPVOID param)
+{
+	std::shared_ptr<check_job>* job = (std::shared_ptr<check_job>*)param;
+	(*job)->result = (*job)->check();
+	delete job;
+	return 0;
+}
+
+int run_check(std::function<int()> check, const TCHAR* szMsg)
+{
+	std::shared_ptr<check_job> job = std::make_shared<check_job>();
+	job->check = std::move(check);
+
+	/* The code _print_check_result is going to give it */
+	trace_mark(current_category * 1000 + checks_in_category + 1, TEXT("start"), szMsg);
+
+	std::shared_ptr<check_job>* ref = new std::shared_ptr<check_job>(job);
+	HANDLE thread = CreateThread(NULL, 0, check_thread, ref, 0, NULL);
+	if (!thread) {
+		delete ref;
+		return job->check();
+	}
+	DWORD wait = WaitForSingleObject(thread, check_timeout_ms);
+	CloseHandle(thread);
+	return wait == WAIT_OBJECT_0 ? job->result : CHECK_BLOCKED;
+}
+
