+/*
+ * Every check of exec_check runs on a thread of its own: one that does not return within
+ * check_timeout_ms is reported as blocked (CHECK_BLOCKED), its thread left behind, and the run
+ * goes on. The trace marks each check's start too, so a run that still hangs shows where.
+ */
+#define CHECK_BLOCKED (-1000)
+/* Added to a blocked check's code in its thread's and the process's exit code */
+#define CHECK_BLOCKED_BASE 100000
+extern DWORD check_timeout_ms;
+int run_check(std::function<int()> check, const TCHAR* szMsg);
+
+/*
+ * Every check that reports a result has a code of its own: its category times 1000
+ * plus its position in the category, in the order the checks run (VBOX's 12th
+ * check is 5012). Every result line shows it. A run exits with the code of the
+ * first check that detected something, else CHECK_BLOCKED_BASE plus the first blocked
+ * one's, else 0. A trace of syscalls shows them all, as they happen: an event named
+ * "al-khaser <code> <start|detected|blocked> <check>" (NtCreateEvent; "category" with the
+ * category's code * 1000 when one begins), and for a detection a thread that exits with
+ * the code (NtTerminateThread), CHECK_BLOCKED_BASE + code for a blocked check.
+ */
+enum CHECK_CATEGORY {
+	CATEGORY_TLS = 1,
+	CATEGORY_DEBUG = 2,
+	CATEGORY_INJECTION = 3,
+	CATEGORY_GEN_SANDBOX = 4,
+	CATEGORY_VBOX = 5,
+	CATEGORY_VMWARE = 6,
+	CATEGORY_VPC = 7,
+	CATEGORY_QEMU = 8,
+	CATEGORY_XEN = 9,
+	CATEGORY_KVM = 10,
+	CATEGORY_WINE = 11,
+	CATEGORY_PARALLELS = 12,
+	CATEGORY_HYPERV = 13,
+	CATEGORY_TIMING = 14,
+	CATEGORY_ANALYSIS_TOOLS = 15,
+	CATEGORY_HUMAN_INTERACTION = 16,
+};
+
+VOID begin_category(UINT category, const TCHAR* text);
