 {
-	if (result == TRUE)
+	UINT code = current_category * 1000 + ++checks_in_category;
+
+	_tprintf(TEXT("%5u "), code);
+	if (result == CHECK_BLOCKED) {
+		print_blocked();
+		blocked.push_back(code);
+		trace_mark(code, TEXT("blocked"), szMsg);
+		trace_exit_code(CHECK_BLOCKED_BASE + code);
+	}
+	else if (result == TRUE) {
 		print_detected();
+		detections.push_back(code);
+		trace_mark(code, TEXT("detected"), szMsg);
+		trace_exit_code(code);
+	}
 	else
 		print_not_detected();
 
