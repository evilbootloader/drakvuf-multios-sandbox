-	_stprintf_s(buffer, sizeof(buffer) / sizeof(TCHAR), _T("[*] %s -> %d"), szMsg, result);
+	_stprintf_s(buffer, sizeof(buffer) / sizeof(TCHAR), _T("[%u] %s -> %d"), code, szMsg, result);
 	LOG_PRINT(buffer);
 }
 
+VOID begin_category(UINT category, const TCHAR* text)
+{
+	current_category = category;
+	checks_in_category = 0;
+	print_category(text);
+	trace_mark(category * 1000, TEXT("category"), text);
+}
+
+UINT report_detections()
+{
+	_tprintf(TEXT("\n\n[*] Checks that detected something: %u"), (UINT)detections.size());
+	LOG_PRINT(_T("[*] Checks that detected something: %u"), (UINT)detections.size());
+	for (UINT code : detections) {
+		_tprintf(TEXT(" %u"), code);
+		LOG_PRINT(_T("[*] Detected: %u"), code);
+	}
+
+	_tprintf(TEXT("\n[*] Checks that did not return within %u s: %u"), check_timeout_ms / 1000, (UINT)blocked.size());
+	LOG_PRINT(_T("[*] Checks that did not return within %u s: %u"), check_timeout_ms / 1000, (UINT)blocked.size());
+	for (UINT code : blocked) {
+		_tprintf(TEXT(" %u"), code);
+		LOG_PRINT(_T("[*] Blocked: %u"), code);
+	}
+	_tprintf(TEXT("\n"));
+
+	if (!detections.empty())
+		return detections.front();
+	return blocked.empty() ? 0 : CHECK_BLOCKED_BASE + blocked.front();
+}
+
