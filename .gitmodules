[submodule "drakvuf"]
	path = drakvuf
	url = https://github.com/evilbootloader/drakvuf.git
	ignore = untracked
	# develop is where the pins come from; `main` here let `git submodule
	# update --remote` move the pin to a commit never deployed (review L-23)
	branch = stable
[submodule "sandboxd/data/protections-artifacts"]
	path = sandboxd/data/protections-artifacts
	url = https://github.com/elastic/protections-artifacts.git
[submodule "sandboxd/data/capa-rules"]
	path = sandboxd/data/capa-rules
	url = https://github.com/mandiant/capa-rules.git
[submodule "sandboxd/data/falco-rules"]
	path = sandboxd/data/falco-rules
	url = https://github.com/falcosecurity/rules.git
