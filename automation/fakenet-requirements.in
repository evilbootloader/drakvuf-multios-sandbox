# FakeNet-NG v3.5 on Dom0 -- the dependency set this lab actually runs.
# DRAFT-057 Phase 3. See automation/fakenet.ini and fakenet-divert-no.patch.
#
# This is the SOURCE of automation/fakenet-requirements.txt, which is generated
# from it with every version pinned and the sha256 of every distribution file:
#
#     uv pip compile --universal --generate-hashes \
#         automation/fakenet-requirements.in -o automation/fakenet-requirements.txt
#
# Install that FIRST, in hash-checking mode, and then FakeNet itself with
# --no-deps, so that upstream's own list never gets a vote, by the commit the
# tag v3.5 named on 2026-11-03 (Makefile, FAKENET_COMMIT): a tag can be moved,
# a commit cannot.
#
#     /opt/fakenet-ng/bin/pip install --require-hashes -r automation/fakenet-requirements.txt
#     /opt/fakenet-ng/bin/pip install --no-deps \
#         'git+https://github.com/mandiant/flare-fakenet-ng@82c01b00f8da2f29fc4ae77c6f5546bb26dd8904'
#
# netifaces still builds its C extension from the (hash-checked) sdist, as
# root, since the responder's venv is root's: automation/fakenet.service,
# KNOWN GAP.
#
# Upstream's `requirements` in setup.py is unpinned and wrong for this host in
# both directions -- it demands something we never load and floats something
# that has already broken.

# ==========================================================================
# pyOpenSSL 26.2.0 REMOVED the API FakeNet builds its certificates with.
# ==========================================================================
#
# `OpenSSL.crypto.X509Extension` and `X509.add_extension`/`get_extensions`
# went in 26.2.0 (2026-05-04), deprecated since 23.3.0. FakeNet's
# `listeners/ssl_utils` uses all of them to mint the MITM certificate the
# proxy presents, and builds that wrapper in `ProxyListener.start()` for TCP
# unconditionally -- whether or not any sample ever speaks TLS. So this is not
# a degraded-TLS failure. It is:
#
#     module 'OpenSSL.crypto' has no attribute 'X509Extension'
#
# logged once, followed by `sys.exit(1)`, before the first port is bound.
#
# **This pin is a countdown, not a fix.** 26.x also deprecated `PKey.generate_key`,
# `dump_privatekey`, `X509.sign`, `X509Name` and every mutable method on X509 --
# which is essentially all of what ssl_utils does. The real repair is upstream
# moving to `cryptography.x509.CertificateBuilder`; rewriting certificate
# generation ourselves would be a large patch in a security-relevant path to
# save a version pin, which is the wrong trade for a lab responder minting
# throwaway certs. Re-check this before moving off v3.5.
pyopenssl<26.2

# pyopenssl's own dependency, named here so the resolver has both to work with
# rather than resolving one against a floating other.
cryptography

# DNSListener parses and builds every query and response with this.
dnslib

# Reached through diverterbase -> fnpacket, which fakenet.py imports at startup
# regardless of DivertTraffic.
dpkt

# fakenet.py enumerates interfaces with it at module scope.
netifaces

# FTPListener is built on it, including the passive-data range.
pyftpdlib

# diverterbase renders configs/html_report_template.html with it.
jinja2

# DELIBERATELY ABSENT:
#
#   netfilterqueue  upstream declares it on Linux and only diverters/linux.py
#                   imports it, lazily, inside the DivertTraffic branch we
#                   never enter. It is also the dependency most likely to fail
#                   to build, and installing FakeNet with --no-deps is what
#                   stops that failure blocking an install that does not need
#                   it.
#
#   pydivert        Windows only.
#
#   requests        imported inside a function in HTTPListener's own __main__
#                   self-test, never on the serving path.