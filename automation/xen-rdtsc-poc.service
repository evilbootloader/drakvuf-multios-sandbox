# Turns on Xen's RDTSC compensation once per boot. `make xen` installs it as
# /etc/systemd/system/xen-rdtsc-poc.service and enables it.
#
# Two switches, see docs/architecture/rdtsc-poc.md: the rdtsc-poc=1 boot option
# (XEN_CMDLINE) makes every RDTSC of a guest created with altp2m exit to Xen,
# and the 'd' debug key makes Xen answer those exits on the compensated
# timeline. Without this unit the guests' RDTSCs exit and are answered with the
# plain guest TSC: slower, and no less detectable.
#
# 'd' only sets a flag, so pressing it before any guest exists is fine; it is
# pressed once per boot all the same, as it always has been.

[Unit]
Description=Turn on Xen's RDTSC compensation (xl debug-keys d)
# xl needs xenstored. On a Xen built with --enable-systemd that is
# xenstored.service, not the generated xencommons.service: that one runs the
# init script, which repeats what the systemd units did and fails on every boot
# (its second QEMU disk backend finds the first one's pid file locked).
Requires=xenstored.service
After=xenstored.service xen-init-dom0.service
ConditionPathExists=/proc/xen/capabilities

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xl debug-keys d
# The key only sets a flag and `xl debug-keys` exits 0 whatever Xen did with
# it, so until 2026-11-03 this unit was "active (exited)" on a boot where the
# compensation never came on -- xenstored late, a Xen without the patch -- and
# every analysis ran in the detectable mode with no symptom anywhere. Xen
# reports the switch in its log; the unit now FAILS unless it finds that line,
# the same one evasion-tests/search_common.sh checks before a run, and
# sandboxd logs a warning at startup if the boot line asked for rdtsc-poc=1
# and the line is missing.
ExecStartPost=/bin/sh -c '/usr/local/sbin/xl dmesg | grep -q "RDTSC_POC: compensation enabled"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
