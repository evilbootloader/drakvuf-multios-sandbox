# /etc/sandboxd/sandboxd.env -- sandboxd's environment on Dom0.
#
# A TEMPLATE. `make sandboxd` fills in @VMIP@, @TOTAL_MIB@, @WORKER_TOKEN@,
# @REPO_ROOT@ and @ANALYSIS_VM_USER@ with sed and installs the result mode 600,
# REPLACING the file -- it used to append, so every re-run of the target added
# a second copy of every line. The SANDBOXD_INJECTION_PID_* lines are the one
# exception: a re-run carries them over, because `make setup_hooks_*` wrote
# them and the daemon injects into nothing without them.
# To write one by hand: copy it, replace the five placeholders, chmod 600.
#
# sandboxd has no systemd unit and does not read this file itself. Source it
# before starting the daemon (docs/CURRENT-STATE.md §1.2):
#
#   set -a; . /etc/sandboxd/sandboxd.env; set +a
#   .venv-sandboxd/bin/python -m sandboxd.daemon
#
# Every variable here is one sandboxd/daemon.py reads; docs/CURRENT-STATE.md §3
# lists them, generated from that file.

# --- required: the daemon exits at once without these ----------------------

# The platform's one listener, browser and worker traffic together (runbook 17).
SANDBOXD_API=https://@VMIP@:8000
# THIS host's credential: `create_worker.py <name> --rotate` on the platform
# prints it. Stored there as a sha256 and revoked by rotating it again.
WORKER_TOKEN=@WORKER_TOKEN@
# MiB this Dom0 may give to clones. There is no safe default -- compute it
# from the totals: `xl info` total_memory, less Domain-0's allocation
# (`xl list`), less the platform DomU's (`memory =` in its cfg), less
# 2000 MiB for Xen itself. Not from free_memory, which counts whatever runs
# at that moment (review L-6).
SANDBOXD_TOTAL_MIB=@TOTAL_MIB@

# --- the channel to the platform -------------------------------------------

SANDBOXD_CACERT=/etc/sandboxd/tls/ca.crt
# INERT since runbook 17 (2026-09-15): the mutual-TLS listener these were for
# is gone, and :8000 asks for no client certificate. Harmless; kept so a host
# pointed back at a mutual-TLS listener still presents one.
SANDBOXD_CLIENT_CERT=/etc/sandboxd/tls/dom0-lab.crt
SANDBOXD_CLIENT_KEY=/etc/sandboxd/tls/dom0-lab.key
# Defaults to this host's name.
#SANDBOXD_WORKER_ID=dom0-1

# --- this host (sed-edited into sandboxd/config.py until 2026-11-03) ---------

# Where this checkout lives: the LibVMI profiles, the guest configs and the
# saved states are found under it.
SANDBOXD_REPO_ROOT=@REPO_ROOT@
# The user the analysis guests run as; samples are staged on its Desktop.
SANDBOXD_ANALYSIS_USERNAME=@ANALYSIS_VM_USER@
# The PID each guest's injection anchors on, valid only for the saved state it
# was read from. `make setup_hooks_windows` writes the Windows one here after
# reading it from the running template; Ubuntu anchors on PID 1; Android's
# must be re-derived after every re-save of its state (CURRENT-STATE §1.4).
#SANDBOXD_INJECTION_PID_UBUNTU=1
#SANDBOXD_INJECTION_PID_WINDOWS=4724
#SANDBOXD_INJECTION_PID_ANDROID=3251
# Windows' NETWORK step anchors on services.exe, not explorer.exe: `netsh`
# needs an administrator token and explorer.exe runs without one, so from it
# every clone kept DHCP and reached nothing (2026-11-11). Written by
# `make setup_hooks_windows` with the one above, same lifetime.
#SANDBOXD_INJECTION_PID_WINDOWS_NETCFG=816

# --- capacity ----------------------------------------------------------------

# Must match the VLANs network-setup.sh provisions: one per concurrent clone.
SANDBOXD_MAX_CLONES=3
# Defaults to SANDBOXD_MAX_CLONES.
#SANDBOXD_MAX_SLOTS=3
# MiB the postprocessing child may allocate (RLIMIT_DATA). 3072 by default,
# sized for 8192 M of Dom0 memory and two clone slots -- POSTPROCESS_MAX_MIB
# in sandboxd/config.py has the arithmetic and the 2026-11-02 OOM kill behind
# it. One child per job in its collect phase, so size it against
# SANDBOXD_MAX_CLONES. 0 removes the limit.
#SANDBOXD_POSTPROCESS_MAX_MIB=3072

# --- live console (DRAFT-056) ------------------------------------------------

# Off unless 1/true/yes/on: it dials a relay socket OUT of this host for every
# analysis. The platform's own CONSOLE_ENABLED must be on as well.
SANDBOXD_CONSOLE_ENABLED=1
# The listener the BROWSER reaches; both ends of a session must meet on the
# same uvicorn process.
SANDBOXD_CONSOLE_API=https://@VMIP@:8000

# --- screenshots (DRAFT-054) -------------------------------------------------

# ON unless 0/false/no/off: a PNG of every clone's console every 2 s, read on
# Dom0's loopback with nothing in the guest (sandboxd/screenshots.py).
SANDBOXD_SCREENSHOTS_ENABLED=1

# OFF: once the platform has accepted a job's results, its directory under
# /var/lib/sandboxd/results is deleted. A run that failed, was cancelled, was
# truncated, or kept a raw trace.log is kept whatever this says. 1 keeps every
# one -- for a runbook that reads them on Dom0, or for debugging.
SANDBOXD_KEEP_RESULTS=0

# --- measurement and regression switches: leave unset ------------------------

# Overrides EVERY job's plugin set; a measurement tool (DRAKVUF #108).
#SANDBOXD_PLUGINS=syscalls,procmon
# Offers `direct` egress -- clones NAT'd out of this host's own uplink.
#SANDBOXD_ALLOW_DIRECT=1
#SANDBOXD_LOG_LEVEL=INFO
