# /etc/sandbox_platform/api.env -- the platform API's environment, on the
# platform DomU (`make web_sandbox`).
#
# A TEMPLATE. `make web_sandbox` fills in @VMIP@, @SANDBOX_WEB@,
# @RETENTION_DAYS@, @ANALYSIS_USERNAME@ and @JWT_SIGNING_KEY@ with sed and
# appends the result to the file platform/garage/provision.sh has just written.
# That script TRUNCATES the file to its two S3 lines first, so a re-run never
# duplicates what follows.
# To write one by hand: copy it, replace the placeholders, add the two S3 keys,
# chmod 600, chown platform:platform.
#
# Every variable the platform reads is in platform/sandbox_platform/config.py,
# with its default and the reason for it.

# Written by platform/garage/provision.sh, never by this template:
#   S3_ACCESS_KEY
#   S3_SECRET_KEY

DATABASE_URL=postgresql:///sandbox_platform

# TWO endpoints, and they are not interchangeable. SigV4 signs the Host
# header, so a URL signed for one host is rejected at the other. Dom0 reaches
# the store over the LAN, browsers reach it through the tunnel.
S3_INTERNAL_ENDPOINT=https://@VMIP@:9000
S3_PUBLIC_ENDPOINT=https://@SANDBOX_WEB@
S3_BUCKET=analysis
# MUST equal s3_region in /etc/garage.toml. The region is part of the SigV4
# signing scope, so a mismatch fails every presigned URL with a 403 that
# discusses signatures and never mentions regions.
S3_REGION=eu-central-1
S3_CA_BUNDLE=/etc/sandbox_platform/tls/ca.crt
# MUST equal the bucket's lifecycle rule, which provision.sh set from the same
# Makefile value (S3_RETENTION). The API reports a job's artifacts as expired
# by this number, so a mismatch offers downloads the store has already deleted
# -- or hides ones it still holds. Unset, it defaulted to 30 whatever the
# bucket said.
RETENTION_DAYS=@RETENTION_DAYS@

# The analysis guests' user, so the submit form can show where a sample will
# be dropped (/home/<user>/Desktop, C:\Users\<user>\Desktop). Display only:
# the analysis host builds the real path from sandboxd/config.py, which
# `make sandboxd` writes from the same Makefile value (ANALYSIS_VM_USER).
ANALYSIS_USERNAME=@ANALYSIS_USERNAME@

JWT_SIGNING_KEY=@JWT_SIGNING_KEY@
JWT_ISSUER=@SANDBOX_WEB@
JWT_AUDIENCE=sandbox-platform
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=1

# --- login throttling --------------------------------------------------------
# Behind cloudflared the socket peer is ALWAYS the tunnel, so without this
# every user shares one rate-limit bucket and the per-IP limit is global.
TRUSTED_CLIENT_IP_HEADER=
ATTEMPTS_PER_WINDOW=5
WINDOW_LENGTH_MINUTES=5
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=5
DECAY_WINDOW_MINUTES=5
# 4 x 64 MiB argon2id = 256 MiB peak on a 4096 MiB DomU. Raise only with the
# host, and recompute the PRODUCT -- neither factor alone is the bound.
MAX_CONCURRENT_HASHES=4

# --- live console (DRAFT-056) ------------------------------------------------
# The platform's half of the switch; sandboxd's SANDBOXD_CONSOLE_ENABLED is the
# other, and a session needs both.
CONSOLE_ENABLED=True

# --- self-service signup -----------------------------------------------------
# OFF unless you want it. What it gates is not "an account" but the opening
# grant of 3600 analysis seconds, so an open route is free compute for anyone
# with an email address and a Telegram account. Closed, create_user.py is the
# only way in -- and password reset still works for accounts that exist.
REGISTRATION_OPEN=0
