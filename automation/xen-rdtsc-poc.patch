+
+
+#define TSC_STEP 10ULL
+#define TSC_MIN_GAP 20ULL
+#define RDTSC_POC_U64_MAX (~(uint64_t)0)
+/* Gaps up to this many cycles of guest time are close pairs, like a red pill test. */
+#define RDTSC_CLOSE_GAP 20000ULL
+/* What a red pill test accepts between two RDTSCs */
+#define RDTSC_CLOSE_DELTA 100ULL
+/*
+ * A close pair may take the lag this far above lag_gap: the timeline then catches
+ * up on a later read with a larger gap, where a jump does not show. It bounds how
+ * much longer a TSC busy-wait can take (300000 cycles: 100 us at 3 GHz).
+ */
+#define RDTSC_CLOSE_HEADROOM 300000ULL
+/*
+ * Stolen time hidden at most, and only inside close pairs: guest timers are
+ * deadlines on the real guest TSC, so a timeline seconds behind it (a restore or
+ * an injection holds the vCPU for that long) leaves the guest crawling.
+ * 3000000 cycles: 1 ms at 3 GHz.
+ */
+#define RDTSC_STEAL_MAX 3000000ULL
+/*
+ * Ceiling for the gate and the lag_gap. Without sleep and stolen time, a gap above
+ * it is the guest's own work, however common it is in the window (a run of 8 ms
+ * gaps once made both jump there and the guest crawl). 1000000 cycles: 0.33 ms.
+ */
+#define RDTSC_GAP_CEILING 1000000ULL
+/*
+ * 1: a gap is the time the vCPU ran the guest, from each VM entry to its VM exit,
+ * so Xen's handling of the exits DRAKVUF causes is out of it as well as stolen
+ * time. 0: the host time minus stolen time.
+ */
+#define RDTSC_GAP_RUN 0
+/*
+ * 1: kernel, library and vDSO RDTSCs are compressed on the vCPU's timeline as
+ * well. 0: they return the guest TSC as is. A Linux guest on the xen clocksource
+ * and clockevent turns the TSC into its clock (pvclock) and its timer deadlines
+ * (absolute Xen system time); a kernel clock behind the real one fires every
+ * timer early, and the guest freezes in a storm of timer interrupts.
+ */
+#define RDTSC_KERNEL_ADJUST 0
+/*
+ * A user RDTSC in a program's own code returns the previous one on its vCPU plus a
+ * few cycles if the vCPU ran the guest at most this long in between and did not
+ * sleep: Xen's handling of the exits in between, pauses and waits are not guest
+ * run time. 1000000 cycles: 0.33 ms at 3 GHz. A red pill pair under DRAKVUF's
+ * dev-all ran up to 133k cycles (the kernel logging UMIP's warning, ~27 exits);
+ * 200000 still missed the first detector run after a restore.
+ */
+#define RDTSC_USER_CLOSE 1000000ULL
+/*
+ * Most guest time such a read hides. DRAKVUF paused a red pill pair up to 4.7M
+ * cycles. 30000000 cycles: 10 ms at 3 GHz.
+ */
+#define RDTSC_USER_LAG_MAX 30000000ULL
+/*
+ * User RDTSCs in a program's own code: below RDTSC_USER_RIP_MAX, where Linux maps
+ * programs (its shared libraries and vDSO from about 0x7f0000000000 up), and from
+ * RDTSC_USER_EXE_LO to RDTSC_USER_EXE_HI, where 64-bit Windows maps executables (its
+ * DLLs, QueryPerformanceCounter's included, from about 0x7ff800000000 up). Linux puts
+ * libraries in that band rarely: it is 8 GB of the 1 TB their base is randomised over.
+ */
+#define RDTSC_USER_RIP_MAX 0x7f0000000000ULL
+#define RDTSC_USER_EXE_LO 0x7ff600000000ULL
+#define RDTSC_USER_EXE_HI 0x7ff800000000ULL
+
+/*
+ * 1: a read with no VM exit since the previous one (no syscall, fault or CPUID took
+ * the vCPU out) returns that one plus the guest's own work in between: the run time
+ * less the least seen for such a pair, which is the cost of the RDTSC exit itself.
+ * al-khaser's Locky check wants CloseHandle(0) (40-90 cycles of work) to take 10
+ * times GetProcessHeap()'s (none); a fixed step of 10-25 cycles never does. Reads
+ * with exits between keep the fixed step: the red pill's SIDT and CPUID's exit.
+ */
+#define RDTSC_USER_PURE 0
+
+static bool rdtsc_program_rip(uint64_t rip)
+{
+    return rip < RDTSC_USER_RIP_MAX ||
+           (rip >= RDTSC_USER_EXE_LO && rip < RDTSC_USER_EXE_HI);
+}
+
+/* The guest's pvclock timestamp: a TSC below it would wrap its clock forward */
+static uint64_t rdtsc_pvclock_stamp(const struct vcpu *v)
+{
+    if ( !v->vcpu_info_area.map )
+        return 0;
+
+    return vcpu_info(v, time.tsc_timestamp);
+}
+
+/*
+ * A user RDTSC in a program's own code, on the vCPU's program timeline t. Kernel,
+ * library and vDSO reads are not on it, so the guest's clock and timers keep the
+ * real TSC. The domain's rdtsc_lock is held.
+ */
+static uint64_t rdtsc_poc_user(
+    struct vcpu *v,
+    struct rdtsc_user_timeline *t,
+    uint64_t blocked,
+    uint64_t host_tsc,
+    uint64_t normal_tsc)
+{
+    struct rdtsc_poc_vcpu *a = &v->arch.hvm.vmx.rdtsc_poc;
+    uint64_t result = normal_tsc;
+
+    t->reads++;
+
+    if ( !t->valid )
+        a->why = RDTSC_WHY_NO_BASELINE;
+    else if ( blocked != t->blocked_ns )
+    {
+        a->why = RDTSC_WHY_SLEPT;
+        t->slept++;
+    }
+    else if ( a->run_tsc - t->run_tsc > RDTSC_USER_CLOSE )
+    {
+        a->why = RDTSC_WHY_FAR;
+        t->far++;
+    }
+    else
+    {
+        uint64_t candidate = t->last_returned + TSC_STEP + (host_tsc & 0xf);
+
+        /* Only this RDTSC's own exit since the previous read */
+        if ( RDTSC_USER_PURE && a->exits - t->exits == 1 )
+        {
+            uint64_t run = a->run_tsc - t->run_tsc;
+
+            if ( run < t->run_min )
+                t->run_min = run;
+            candidate = t->last_returned + 1 + (run - t->run_min);
+            t->pure++;
+        }
+
+        if ( candidate > normal_tsc ||
+             normal_tsc - candidate > RDTSC_USER_LAG_MAX )
+        {
+            a->why = RDTSC_WHY_LAG;
+            t->lag++;
+        }
+        else
+        {
+            uint64_t stamp = rdtsc_pvclock_stamp(v);
+
+            if ( candidate < stamp )
+            {
+                candidate = stamp;
+                t->pvclock++;
+            }
+
+            result = candidate;
+            a->why = RDTSC_WHY_COMPRESSED;
+            t->compressed++;
+            if ( normal_tsc - result > t->max_hidden )
+                t->max_hidden = normal_tsc - result;
+        }
+    }
+
+    /* Never backwards on the timeline */
+    if ( t->valid && result <= t->last_returned )
+        result = t->last_returned + 1;
+
+    if ( !t->valid )
+        t->run_min = RDTSC_POC_U64_MAX;
+    t->last_returned = result;
+    t->run_tsc = a->run_tsc;
+    t->blocked_ns = blocked;
+    t->exits = a->exits;
+    t->valid = true;
+
+    return result;
+}
+
+/*
+ * Follows the red pill like pairs of the vCPU through this read, judged as why.
+ * The domain's rdtsc_lock is held.
+ */
+static void rdtsc_pair_track(
+    struct rdtsc_gap_window *w,
+    const struct vcpu *v,
+    uint64_t rip,
+    uint64_t cr3,
+    bool user,
+    uint64_t host_tsc,
+    uint64_t stolen_ns,
+    uint64_t gap,
+    uint64_t result,
+    uint8_t why)
+{
+    const struct rdtsc_poc_vcpu *a = &v->arch.hvm.vmx.rdtsc_poc;
+    struct rdtsc_pair_chain *c;
+
+    if ( v->vcpu_id >= RDTSC_PAIR_VCPUS )
+        return;
+
+    c = &w->chain[v->vcpu_id];
+
+    if ( c->rip )
+    {
+        c->reads++;
+        c->gap += gap;
+        if ( gap > c->max_gap )
+            c->max_gap = gap;
+        if ( c->why == RDTSC_WHY_COMPRESSED && why != RDTSC_WHY_KERNEL )
+            c->why = why;
+
+        if ( user && cr3 == c->cr3 &&
+             (rip > c->rip ? rip - c->rip : c->rip - rip) < RDTSC_PAIR_RIP )
+        {
+            uint64_t delta = result > c->result ? result - c->result : 0;
+            uint64_t exits = a->exits - c->exits - c->reads;
+
+            w->pairs++;
+            if ( delta <= RDTSC_CLOSE_DELTA )
+                w->pairs_ok++;
+
+            w->pair_log[w->pair_head] = (struct rdtsc_pair_entry) {
+                .rip = rip,
+                .host_gap = host_tsc - c->host_tsc,
+                .stolen = muldiv64(stolen_ns - c->stolen_ns, cpu_khz, 1000000),
+                .run = a->run_tsc - c->run_tsc,
+                .gap = c->gap,
+                .max_gap = c->max_gap,
+                .delta = delta,
+                .exits = exits > UINT32_MAX ? UINT32_MAX : exits,
+                .vcpu = v->vcpu_id,
+                .reads = c->reads,
+                .why = c->why,
+            };
+
+            if ( ++w->pair_head == RDTSC_PAIR_LOG )
+                w->pair_head = 0;
+        }
+        else if ( !user && c->reads < RDTSC_PAIR_READS )
+            return;
+    }
+
+    /* A user read in a program's own code starts a new chain, anything else ends it */
+    if ( !user || !rdtsc_program_rip(rip) )
+    {
+        c->rip = 0;
+        return;
+    }
+
+    *c = (struct rdtsc_pair_chain) {
+        .rip = rip,
+        .cr3 = cr3,
+        .result = result,
+        .host_tsc = host_tsc,
+        .run_tsc = a->run_tsc,
+        .stolen_ns = stolen_ns,
+        .exits = a->exits,
+        .why = RDTSC_WHY_COMPRESSED,
+    };
+}
+
+/*
+ * The value of a guest RDTSC on this vCPU's timeline. gap is the guest time since
+ * the vCPU's previous RDTSC exit, without the off_tsc cycles it spent off the guest
+ * (paused, waiting for a pCPU, and with RDTSC_GAP_RUN in Xen). A gap the window
+ * counts as normal is compressed to a few cycles, as long as the timeline stays
+ * within lag_gap of the guest TSC; a close pair may hide off_tsc on top of that.
+ * The domain's rdtsc_lock is held.
+ */
+static uint64_t rdtsc_poc_adjust(
+    struct vcpu *v,
+    bool have_gap,
+    uint64_t gap,
+    uint64_t off_tsc,
+    uint64_t host_tsc,
+    uint64_t normal_tsc)
+{
+    struct rdtsc_poc_vcpu *a =
+        &v->arch.hvm.vmx.rdtsc_poc;
+
+    uint64_t result = normal_tsc;
+
+    uint64_t last_returned_tsc = a->last_returned_tsc;
+    bool is_close = false, lag_fail = false, gate_fail = false;
+
+    a->why = RDTSC_WHY_SLEPT;
+
+    if ( have_gap && a->returned_valid )
+    {
+        uint64_t max_gap = 0;
+        uint64_t lag_gap = 0;
+        bool have_baseline =
+            rdtsc_window_baseline(v->domain->arch.hvm.vmx.rdtsc_window,
+                                  &max_gap, &lag_gap);
+
+        if ( max_gap > RDTSC_GAP_CEILING )
+            max_gap = RDTSC_GAP_CEILING;
+        if ( lag_gap > RDTSC_GAP_CEILING )
+            lag_gap = RDTSC_GAP_CEILING;
+
+        is_close = gap <= RDTSC_CLOSE_GAP;
+
+        if ( !have_baseline )
+        {
+            a->why = RDTSC_WHY_NO_BASELINE;
+            a->baseline_missing++;
+        }
+        else if ( gap > max_gap )
+        {
+            a->why = RDTSC_WHY_GATE_HIGH;
+            a->gate_high_rejections++;
+            gate_fail = is_close;
+            if ( gap >= 1000000ULL )
+                a->big_gate_high++;
+        }
+        else if ( gap < TSC_MIN_GAP )
+        {
+            a->why = RDTSC_WHY_GATE_LOW;
+            a->gate_low_rejections++;
+        }
+        else
+        {
+            uint64_t step = TSC_STEP + (host_tsc & 0xf);
+
+            /*
+             * Only a close pair may keep the lag above lag_gap: by the headroom,
+             * the time off the guest hidden so far and this gap's, up to
+             * RDTSC_STEAL_MAX. Any other read pays all of it back.
+             */
+            uint64_t allowance = lag_gap;
+            uint64_t hide = 0;
+
+            if ( is_close )
+            {
+                if ( a->hidden_stolen + off_tsc <= RDTSC_STEAL_MAX )
+                    hide = off_tsc;
+                allowance += RDTSC_CLOSE_HEADROOM + a->hidden_stolen + hide;
+            }
+
+            if (last_returned_tsc <= RDTSC_POC_U64_MAX - step)
+            {
+                uint64_t candidate =
+                    last_returned_tsc + step;
+                if ( candidate <= normal_tsc &&
+                     normal_tsc - candidate <= allowance )
+                {
+                    result = candidate;
+                    a->why = RDTSC_WHY_COMPRESSED;
+                    a->hidden_stolen += hide;
+                    a->compressed_reads++;
+                    if ( gap >= 1000000ULL )
+                        a->big_compressed++;
+                }
+                else
+                {
+                    a->why = RDTSC_WHY_LAG;
+                    a->lag_rejections++;
+                    lag_fail = is_close;
+                    if ( gap >= 1000000ULL )
+                        a->big_lag_rejections++;
+                }
+            }
+        }
+    }
+
+    /* A value returned as is pays back all the time hidden so far. */
+    if ( result == normal_tsc )
+        a->hidden_stolen = 0;
+
+    /*
+     * Avoid returning a timestamp older than
+     * the last value returned on this vCPU.
+     */
+    if ( a->returned_valid && result <= last_returned_tsc )
+    {
+        if (last_returned_tsc != RDTSC_POC_U64_MAX)
+            result = last_returned_tsc + 1;
+    }
+
+    if ( result < normal_tsc &&
+         normal_tsc - result > a->max_virtual_lag )
+        a->max_virtual_lag = normal_tsc - result;
+
+    if ( result > normal_tsc )
+        a->ahead_of_normal++;
+
+    if (result == normal_tsc)
+        a->normal_returns++;
+    else
+        a->adjusted_returns++;
+
+    /* Adjacent returned RDTSC values on THIS vCPU, all processes combined.
+     * These are NOT identified as time1/time2 from the detector. */
+    if ( a->returned_valid && result > last_returned_tsc )
+    {
+        uint64_t delta = result - last_returned_tsc;
+
+        if ( delta > 4000 )
+            a->large_forward_jumps++;
+        if ( delta > a->max_forward_jump )
+            a->max_forward_jump = delta;
+
+        if ( delta <= 100 )
+            a->guest_delta_le_100++;
+        else
+            a->guest_delta_gt_100++;
+        if ( delta >= 1000000ULL )
+            a->guest_delta_ge_1m++;
+        if ( delta > a->guest_delta_max )
+            a->guest_delta_max = delta;
+    }
+
+    if ( is_close )
+    {
+        a->close_pairs++;
+        if ( result - last_returned_tsc <= RDTSC_CLOSE_DELTA )
+            a->close_ok++;
+        else if ( lag_fail )
+            a->close_lag++;
+        else if ( gate_fail )
+            a->close_gate++;
+    }
+
+    a->last_returned_tsc = result;
+    a->returned_valid = true;
+
+    return result;
+}
+
+/*
+ * A guest RDTSC/RDTSCP of a RDTSC_POC domain. entry_tsc is the host TSC at the
+ * VM exit, where the gap since this vCPU's previous RDTSC exit ends.
+ */
+static uint64_t rdtsc_poc_read(
+    struct vcpu *v,
+    uint64_t entry_tsc,
+    uint64_t rip,
+    bool user)
+{
+    struct vmx_domain *vmx = &v->domain->arch.hvm.vmx;
+    struct rdtsc_poc_vcpu *a = &v->arch.hvm.vmx.rdtsc_poc;
+    uint64_t blocked = v->runstate.time[RUNSTATE_blocked];
+    uint64_t stolen = v->runstate.time[RUNSTATE_offline] +
+                      v->runstate.time[RUNSTATE_runnable];
+    uint64_t cr3 = v->arch.hvm.guest_cr[3];
+    uint64_t gap = 0, off_tsc = 0, result;
+    bool have_gap;
+
+    spin_lock(&vmx->rdtsc_lock);
+
+    /*
+     * A vCPU that slept (HLT, SCHEDOP_block) since its previous RDTSC: that time
+     * is idle, not the cost of traps, so the gap is neither compressed nor
+     * recorded. Xen switches to the idle vCPU lazily, without
+     * vmx_ctxt_switch_from(), so only the runstate tells.
+     */
+    if ( blocked != a->blocked_ns )
+    {
+        a->blocked_ns = blocked;
+        a->gap_valid = false;
+        a->sleep_breaks++;
+    }
+
+    have_gap = a->gap_valid && entry_tsc >= a->last_host_tsc;
+    if ( have_gap )
+    {
+        uint64_t host_gap = entry_tsc - a->last_host_tsc;
+        uint64_t run_gap = a->run_tsc - a->last_run_tsc;
+
+        /*
+         * Time the vCPU was paused (vm_event, domain pauses) or waited for a
+         * pCPU is not guest time: the gap is what the guest ran.
+         */
+        uint64_t stolen_tsc = muldiv64(stolen - a->stolen_ns, cpu_khz, 1000000);
+
+        gap = host_gap;
+        if ( stolen_tsc )
+        {
+            gap = host_gap > stolen_tsc + TSC_MIN_GAP ? host_gap - stolen_tsc
+                                                      : TSC_MIN_GAP;
+            a->stolen_reads++;
+            if ( stolen_tsc > a->stolen_max )
+                a->stolen_max = stolen_tsc;
+        }
+
+        /* Xen's handling of every VM exit in between is out of it too */
+        if ( RDTSC_GAP_RUN && run_gap < gap )
+            gap = run_gap > TSC_MIN_GAP ? run_gap : TSC_MIN_GAP;
+
+        off_tsc = host_gap > gap ? host_gap - gap : 0;
+        if ( host_gap > RDTSC_CLOSE_GAP && gap <= RDTSC_CLOSE_GAP )
+            a->close_by_steal++;
+
+        if ( gap >= 100000ULL )
+            a->gap_ge_100k++;
+        if ( gap >= 1000000ULL )
+            a->gap_ge_1m++;
+        if ( gap >= 10000000ULL )
+            a->gap_ge_10m++;
+    }
+    a->stolen_ns = stolen;
+
+    result = hvm_get_guest_tsc_fixed(v, rdtsc_ordered());
+
+    /* Collect even when compensation is disabled. */
+    a->why = RDTSC_WHY_OFF;
+    if ( ACCESS_ONCE(rdtsc_poc_apply_enabled) )
+    {
+        if ( user && rdtsc_program_rip(rip) && vmx->rdtsc_window &&
+             v->vcpu_id < RDTSC_PAIR_VCPUS )
+            result = rdtsc_poc_user(v, &vmx->rdtsc_window->user[v->vcpu_id],
+                                    blocked, entry_tsc, result);
+        else if ( RDTSC_KERNEL_ADJUST )
+            result = rdtsc_poc_adjust(v, have_gap, gap, off_tsc,
+                                      entry_tsc, result);
+        else
+            a->why = RDTSC_WHY_KERNEL;
+    }
+
+    if ( vmx->rdtsc_window )
+    {
+        rdtsc_pair_track(vmx->rdtsc_window, v, rip, cr3, user, entry_tsc,
+                         stolen, gap, result, a->why);
+
+        /* After this read's decision, so an outlier never approves itself */
+        if ( have_gap )
+            rdtsc_window_push(vmx->rdtsc_window, gap);
+    }
+
+    a->last_host_tsc = entry_tsc;
+    a->last_run_tsc = a->run_tsc;
+    a->gap_valid = true;
+
+    spin_unlock(&vmx->rdtsc_lock);
+
+    return result;
+}
