+#define RDTSC_HIST_SUB      (1U << RDTSC_HIST_SUB_BITS)
+#define RDTSC_HIST_MAX_BITS 40
+#define RDTSC_HIST_MAX_GAP  ((1ULL << RDTSC_HIST_MAX_BITS) - 1)
+#define RDTSC_HIST_GROUPS   (RDTSC_HIST_MAX_BITS - RDTSC_HIST_SUB_BITS + 1)
+#define RDTSC_HIST_BUCKETS  (RDTSC_HIST_GROUPS * RDTSC_HIST_SUB)
