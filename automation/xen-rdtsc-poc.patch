From: =?UTF-8?q?Llu=C3=ADs=20Bessa?= <evilbootloader@proton.me>
Subject: [PATCH] x86/vmx: RDTSC_POC, hide VM exit time from red pill RDTSC pairs

Xen 4.20.1 with automation/xen-altp2m-pause-vcpu.patch applied first.
Squashes drakvuf-dev/xen branch rdtsc-poc 5fa34725a4, dc30449605 and 18aaea8adf;
docs/architecture/rdtsc-poc.md has the design and the evidence.

With the rdtsc-poc boot option, every RDTSC/RDTSCP of a guest created
with altp2m (the ones DRAKVUF analyses) exits to Xen; debug key 'd'
turns the compensation on, key 't' dumps its state. User RDTSCs in a
program's own code (below 0x7f0000000000, Linux programs, and
0x7ff600000000-0x7ff800000000, Windows executables) are compressed on a
timeline of their own per vCPU: one that comes at most RDTSC_USER_CLOSE
(1M) cycles of guest run time after the previous one, with no sleep
between, returns that one plus 10-25 cycles, hiding up to
RDTSC_USER_LAG_MAX (30M). Kernel, library, vDSO and Windows DLL RDTSCs
return the guest TSC as is: a Linux guest on the xen clocksource and
clockevent fires every timer early when its kernel TSC lags, and
freezes. RDTSC_USER_PURE (off) would return the guest's own work for a
pair with no exit between, for al-khaser's Locky check.

---
 xen/arch/x86/hvm/vmx/vmcs.c             |   18 +
 xen/arch/x86/hvm/vmx/vmx.c              | 1088 ++++++++++++++++++++++++++++++-
 xen/arch/x86/include/asm/hvm/vmx/vmcs.h |  216 ++++++
 3 files changed, 1316 insertions(+), 6 deletions(-)

diff --git a/xen/arch/x86/hvm/vmx/vmcs.c b/xen/arch/x86/hvm/vmx/vmcs.c
index f9538063da..9f9e64bd55 100644
--- a/xen/arch/x86/hvm/vmx/vmcs.c
+++ b/xen/arch/x86/hvm/vmx/vmcs.c
@@ -1120,6 +1120,12 @@ static int construct_vmcs(struct vcpu *v)
     if ( d->arch.vtsc && !cpu_has_vmx_tsc_scaling )
         v->arch.hvm.vmx.exec_control |= CPU_BASED_RDTSC_EXITING;
 
+    /*
+    * Enable RDTSC/RDTSCP interception for the PoC domain.
+    */
+    if ( unlikely(d->arch.hvm.vmx.rdtsc_poc_enabled) )
+        v->arch.hvm.vmx.exec_control |= CPU_BASED_RDTSC_EXITING;
+
     v->arch.hvm.vmx.secondary_exec_control = vmx_secondary_exec_control;
     v->arch.hvm.vmx.tertiary_exec_control  = vmx_tertiary_exec_control;
 
@@ -1165,6 +1171,18 @@ static int construct_vmcs(struct vcpu *v)
 
     vmx_update_cpu_exec_control(v);
 
+    if ( d->arch.hvm.vmx.rdtsc_poc_enabled )
+    {
+        printk(XENLOG_INFO
+            "RDTSC_POC: dom=%u vcpu=%u "
+            "exec_control=%#x rdtsc_exiting=%u\n",
+            d->domain_id,
+            v->vcpu_id,
+            v->arch.hvm.vmx.exec_control,
+            !!(v->arch.hvm.vmx.exec_control &
+                CPU_BASED_RDTSC_EXITING));
+    }
+
     __vmwrite(VM_EXIT_CONTROLS, vmexit_ctl);
     __vmwrite(VM_ENTRY_CONTROLS, vmentry_ctl);
 
diff --git a/xen/arch/x86/hvm/vmx/vmx.c b/xen/arch/x86/hvm/vmx/vmx.c
index 1373ef2787..979c1850fd 100644
--- a/xen/arch/x86/hvm/vmx/vmx.c
+++ b/xen/arch/x86/hvm/vmx/vmx.c
@@ -50,9 +50,455 @@
 #include <asm/spec_ctrl.h>
 #include <public/arch-x86/cpuid.h>
 
+#include <xen/keyhandler.h>
+#include <xen/time.h>
+#include <xen/xvmalloc.h>
+
+/* lag_gap is the mean of the sorted window slice [LO, HI), in basis points. */
+#define RDTSC_LAG_LO_BP 9499
+#define RDTSC_LAG_HI_BP 9899
+#define RDTSC_LAG_LO (RDTSC_WINDOW_SIZE * RDTSC_LAG_LO_BP / 10000)
+#define RDTSC_LAG_HI (RDTSC_WINDOW_SIZE * RDTSC_LAG_HI_BP / 10000)
+/* Gaps above this percentile of the window are not compressed. */
+#define RDTSC_GATE_BP 9950
+
+static bool rdtsc_poc_apply_enabled;
+
+static unsigned int rdtsc_hist_bucket(uint64_t gap)
+{
+    unsigned int top;
+
+    if ( gap < RDTSC_HIST_SUB )
+        return gap;
+
+    /* The highest set bit picks the group, the next RDTSC_HIST_SUB_BITS the bucket. */
+    top = flsl(gap) - 1;
+
+    return (top - RDTSC_HIST_SUB_BITS + 1) * RDTSC_HIST_SUB +
+           ((gap >> (top - RDTSC_HIST_SUB_BITS)) & (RDTSC_HIST_SUB - 1));
+}
+
+/* Largest gap that falls in bucket b */
+static uint64_t rdtsc_hist_upper(unsigned int b)
+{
+    unsigned int group = b / RDTSC_HIST_SUB;
+    unsigned int sub = b % RDTSC_HIST_SUB;
+
+    if ( !group )
+        return sub;
+
+    return ((uint64_t)(RDTSC_HIST_SUB + sub + 1) << (group - 1)) - 1;
+}
+
+static void rdtsc_window_account(struct rdtsc_gap_window *w,
+                                 uint64_t gap, bool add)
+{
+    unsigned int b = rdtsc_hist_bucket(gap);
+    unsigned int group = b / RDTSC_HIST_SUB;
+
+    if ( add )
+    {
+        w->count[b]++;
+        w->sum[b] += gap;
+        w->group_count[group]++;
+        w->group_sum[group] += gap;
+        w->ge_100k += gap >= 100000ULL;
+        w->ge_1m += gap >= 1000000ULL;
+        w->ge_10m += gap >= 10000000ULL;
+    }
+    else
+    {
+        w->count[b]--;
+        w->sum[b] -= gap;
+        w->group_count[group]--;
+        w->group_sum[group] -= gap;
+        w->ge_100k -= gap >= 100000ULL;
+        w->ge_1m -= gap >= 1000000ULL;
+        w->ge_10m -= gap >= 10000000ULL;
+    }
+}
+
+/* Adds a gap to the window; once the window is full, the oldest gap leaves. */
+static void rdtsc_window_push(struct rdtsc_gap_window *w, uint64_t gap)
+{
+    if ( gap > RDTSC_HIST_MAX_GAP )
+        gap = RDTSC_HIST_MAX_GAP;
+
+    if ( w->samples == RDTSC_WINDOW_SIZE )
+        rdtsc_window_account(w, w->ring[w->head], false);
+    else
+        w->samples++;
+
+    w->ring[w->head] = gap;
+    rdtsc_window_account(w, gap, true);
+
+    if ( ++w->head == RDTSC_WINDOW_SIZE )
+        w->head = 0;
+}
+
+/* Sum of the k largest gaps of the window */
+static uint64_t rdtsc_window_top_sum(const struct rdtsc_gap_window *w,
+                                     unsigned int k)
+{
+    uint64_t sum = 0;
+    unsigned int group, b;
+
+    for ( group = RDTSC_HIST_GROUPS; k && group-- > 0; )
+    {
+        if ( w->group_count[group] <= k )
+        {
+            k -= w->group_count[group];
+            sum += w->group_sum[group];
+            continue;
+        }
+
+        for ( b = (group + 1) * RDTSC_HIST_SUB;
+              k && b-- > group * RDTSC_HIST_SUB; )
+        {
+            if ( w->count[b] <= k )
+            {
+                k -= w->count[b];
+                sum += w->sum[b];
+            }
+            else
+            {
+                /* Part of a bucket: its mean stands for the gaps taken. */
+                sum += w->sum[b] / w->count[b] * k +
+                       w->sum[b] % w->count[b] * k / w->count[b];
+                k = 0;
+            }
+        }
+    }
+
+    return sum;
+}
+
+/* Top of the bucket that holds the r-th largest gap of the window, r >= 1 */
+static uint64_t rdtsc_window_top_value(const struct rdtsc_gap_window *w,
+                                       unsigned int r)
+{
+    unsigned int group, b;
+
+    for ( group = RDTSC_HIST_GROUPS; group-- > 0; )
+    {
+        if ( w->group_count[group] < r )
+        {
+            r -= w->group_count[group];
+            continue;
+        }
+
+        for ( b = (group + 1) * RDTSC_HIST_SUB; b-- > group * RDTSC_HIST_SUB; )
+        {
+            if ( w->count[b] >= r )
+                return rdtsc_hist_upper(b);
+
+            r -= w->count[b];
+        }
+    }
+
+    return 0;
+}
+
+/* Nearest-rank percentile; basis points: 9000=p90, 9950=p99.5. */
+static uint64_t rdtsc_window_percentile(const struct rdtsc_gap_window *w,
+                                        unsigned int bp)
+{
+    uint64_t rank;
+
+    if ( !w->samples || !bp || bp > 10000 )
+        return 0;
+
+    rank = ((uint64_t)w->samples * bp + 9999) / 10000;
+
+    return rdtsc_window_top_value(w, w->samples - rank + 1);
+}
+
+/*
+ * The baseline, once the window is full: the gate, above which a gap is not
+ * compressed, and the lag_gap, the mean of the slice [RDTSC_LAG_LO, RDTSC_LAG_HI)
+ * of the sorted window, which caps how far the guest TSC may fall behind.
+ */
+static bool rdtsc_window_baseline(const struct rdtsc_gap_window *w,
+                                  uint64_t *max_gap, uint64_t *lag_gap)
+{
+    BUILD_BUG_ON(RDTSC_LAG_HI_BP > 10000);
+    BUILD_BUG_ON(RDTSC_LAG_LO >= RDTSC_LAG_HI);
+
+    if ( !w || w->samples < RDTSC_WINDOW_SIZE )
+        return false;
+
+    *max_gap = rdtsc_window_percentile(w, RDTSC_GATE_BP);
+    *lag_gap = (rdtsc_window_top_sum(w, RDTSC_WINDOW_SIZE - RDTSC_LAG_LO) -
+                rdtsc_window_top_sum(w, RDTSC_WINDOW_SIZE - RDTSC_LAG_HI)) /
+               (RDTSC_LAG_HI - RDTSC_LAG_LO);
+
+    return true;
+}
+
+static const char *const rdtsc_why_name[] = {
+    [RDTSC_WHY_COMPRESSED]  = "compressed",
+    [RDTSC_WHY_OFF]         = "off",
+    [RDTSC_WHY_SLEPT]       = "slept",
+    [RDTSC_WHY_NO_BASELINE] = "no_baseline",
+    [RDTSC_WHY_GATE_HIGH]   = "gate_high",
+    [RDTSC_WHY_GATE_LOW]    = "gate_low",
+    [RDTSC_WHY_LAG]         = "lag",
+    [RDTSC_WHY_KERNEL]      = "kernel",
+    [RDTSC_WHY_FAR]         = "far",
+};
+
+/* Window percentiles in the 't' dump, in basis points */
+static const unsigned int rdtsc_dump_bp[] = {
+    200, 500, 1000, 5000, 8500, 9000, 9500, 9800, 9900, 9950, 9990,
+};
+
+static void cf_check rdtsc_poc_dump(unsigned char key)
+{
+    struct domain *d;
+
+    rcu_read_lock(&domlist_read_lock);
+
+    for_each_domain ( d )
+    {
+        struct vmx_domain *vmx;
+        const struct rdtsc_gap_window *w;
+        uint64_t p[ARRAY_SIZE(rdtsc_dump_bp)] = {};
+        uint64_t max_gap = 0, lag_gap = 0, low = 0, high = 0;
+        uint64_t pairs = 0, pairs_ok = 0;
+        struct rdtsc_pair_entry pair_log[RDTSC_PAIR_LOG] = {};
+        struct {
+            uint64_t reads, compressed, far, slept, lag, pvclock, max_hidden, pure;
+        } prog[RDTSC_PAIR_VCPUS] = {};
+        unsigned int samples = 0, ge_100k = 0, ge_1m = 0, ge_10m = 0, i;
+        bool ready = false;
+        struct vcpu *v;
+
+        if ( !is_hvm_domain(d) ||
+            !d->arch.hvm.vmx.rdtsc_poc_enabled )
+            continue;
+
+        vmx = &d->arch.hvm.vmx;
+
+        /* Copy under the lock, print after it: every RDTSC exit takes it. */
+        spin_lock(&vmx->rdtsc_lock);
+
+        w = vmx->rdtsc_window;
+        if ( w && w->samples )
+        {
+            ready = rdtsc_window_baseline(w, &max_gap, &lag_gap);
+
+            for ( i = 0; i < ARRAY_SIZE(rdtsc_dump_bp); i++ )
+                p[i] = rdtsc_window_percentile(w, rdtsc_dump_bp[i]);
+
+            low = rdtsc_window_top_value(w, w->samples);
+            high = rdtsc_window_top_value(w, 1);
+            samples = w->samples;
+            ge_100k = w->ge_100k;
+            ge_1m = w->ge_1m;
+            ge_10m = w->ge_10m;
+        }
+
+        /* Oldest first */
+        if ( w )
+        {
+            pairs = w->pairs;
+            pairs_ok = w->pairs_ok;
+            for ( i = 0; i < RDTSC_PAIR_LOG; i++ )
+                pair_log[i] = w->pair_log[(w->pair_head + i) % RDTSC_PAIR_LOG];
+
+            for ( i = 0; i < RDTSC_PAIR_VCPUS; i++ )
+            {
+                const struct rdtsc_user_timeline *t = &w->user[i];
+
+                prog[i].reads = t->reads;
+                prog[i].compressed = t->compressed;
+                prog[i].far = t->far;
+                prog[i].slept = t->slept;
+                prog[i].lag = t->lag;
+                prog[i].pvclock = t->pvclock;
+                prog[i].max_hidden = t->max_hidden;
+                prog[i].pure = t->pure;
+            }
+        }
+
+        spin_unlock(&vmx->rdtsc_lock);
+
+        printk(XENLOG_INFO
+            "RDTSC_POC: dom=%u baseline_valid=%u samples=%u window=%u\n",
+            d->domain_id, (unsigned int)ready, samples, RDTSC_WINDOW_SIZE);
+
+        if ( samples )
+        {
+            /* Percentiles, minimum and maximum are the top of their bucket. */
+            printk(XENLOG_INFO
+                "RDTSC_POC: mean=%llu gate=%llu p02=%llu p05=%llu "
+                "p10=%llu p50=%llu p85=%llu p90=%llu "
+                "p95=%llu p98=%llu\n",
+                (unsigned long long)lag_gap,
+                (unsigned long long)max_gap,
+                (unsigned long long)p[0],
+                (unsigned long long)p[1],
+                (unsigned long long)p[2],
+                (unsigned long long)p[3],
+                (unsigned long long)p[4],
+                (unsigned long long)p[5],
+                (unsigned long long)p[6],
+                (unsigned long long)p[7]);
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: p99=%llu p995=%llu p999=%llu "
+                "ge_100k=%u ge_1m=%u ge_10m=%u retained=%u\n",
+                (unsigned long long)p[8],
+                (unsigned long long)p[9],
+                (unsigned long long)p[10],
+                ge_100k, ge_1m, ge_10m,
+                RDTSC_LAG_HI - RDTSC_LAG_LO);
+
+            printk(XENLOG_INFO
+                 "RDTSC_POC: observed_min=%llu "
+                 "observed_max=%llu\n",
+                 (unsigned long long)low,
+                 (unsigned long long)high);
+        }
+
+        printk(XENLOG_INFO
+            "RDTSC_POC: dom=%u pairs=%llu pairs_ok=%llu\n",
+            d->domain_id, (unsigned long long)pairs,
+            (unsigned long long)pairs_ok);
+
+        for ( i = 0; i < RDTSC_PAIR_LOG; i++ )
+        {
+            const struct rdtsc_pair_entry *e = &pair_log[i];
+
+            if ( !e->rip )
+                continue;
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u pair vcpu=%u rip=%#llx host_gap=%llu "
+                "stolen=%llu run=%llu gap=%llu max_gap=%llu reads=%u "
+                "exits=%u delta=%llu why=%s\n",
+                d->domain_id, e->vcpu, (unsigned long long)e->rip,
+                (unsigned long long)e->host_gap,
+                (unsigned long long)e->stolen,
+                (unsigned long long)e->run,
+                (unsigned long long)e->gap,
+                (unsigned long long)e->max_gap, e->reads, e->exits,
+                (unsigned long long)e->delta,
+                e->why < ARRAY_SIZE(rdtsc_why_name) ? rdtsc_why_name[e->why]
+                                                    : "?");
+        }
+
+        /* Best-effort snapshots: vCPU counters change concurrently. */
+        for_each_vcpu ( d, v )
+        {
+            const struct rdtsc_poc_vcpu *a =
+                &v->arch.hvm.vmx.rdtsc_poc;
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u reads=%llu "
+                "compressed=%llu normal=%llu adjusted=%llu "
+                "lag_reject=%llu jumps_gt_4k=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->rdtsc_reads),
+                (unsigned long long)ACCESS_ONCE(a->compressed_reads),
+                (unsigned long long)ACCESS_ONCE(a->normal_returns),
+                (unsigned long long)ACCESS_ONCE(a->adjusted_returns),
+                (unsigned long long)ACCESS_ONCE(a->lag_rejections),
+                (unsigned long long)ACCESS_ONCE(a->large_forward_jumps));
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u "
+                "big_gate=%llu big_lag=%llu big_compressed=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->big_gate_high),
+                (unsigned long long)ACCESS_ONCE(a->big_lag_rejections),
+                (unsigned long long)ACCESS_ONCE(a->big_compressed));
+
+            /* Guest delta is per-vCPU, not necessarily the detector pair. */
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u "
+                "guest_delta_le100=%llu guest_delta_gt100=%llu "
+                "guest_delta_ge1m=%llu guest_delta_max=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->guest_delta_le_100),
+                (unsigned long long)ACCESS_ONCE(a->guest_delta_gt_100),
+                (unsigned long long)ACCESS_ONCE(a->guest_delta_ge_1m),
+                (unsigned long long)ACCESS_ONCE(a->guest_delta_max));
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u "
+                "baseline_miss=%llu gate_high=%llu gate_low=%llu "
+                "slept=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->baseline_missing),
+                (unsigned long long)ACCESS_ONCE(a->gate_high_rejections),
+                (unsigned long long)ACCESS_ONCE(a->gate_low_rejections),
+                (unsigned long long)ACCESS_ONCE(a->sleep_breaks));
+
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u "
+                "max_lag=%llu max_jump=%llu ahead=%llu "
+                "gaps_100k=%llu gaps_1m=%llu gaps_10m=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->max_virtual_lag),
+                (unsigned long long)ACCESS_ONCE(a->max_forward_jump),
+                (unsigned long long)ACCESS_ONCE(a->ahead_of_normal),
+                (unsigned long long)ACCESS_ONCE(a->gap_ge_100k),
+                (unsigned long long)ACCESS_ONCE(a->gap_ge_1m),
+                (unsigned long long)ACCESS_ONCE(a->gap_ge_10m));
+
+            /* Close pairs: returned at most RDTSC_CLOSE_DELTA apart, or why not */
+            printk(XENLOG_INFO
+                "RDTSC_POC: dom=%u vcpu=%u "
+                "close=%llu close_ok=%llu close_lag=%llu close_gate=%llu "
+                "close_by_steal=%llu stolen_reads=%llu stolen_max=%llu\n",
+                d->domain_id, v->vcpu_id,
+                (unsigned long long)ACCESS_ONCE(a->close_pairs),
+                (unsigned long long)ACCESS_ONCE(a->close_ok),
+                (unsigned long long)ACCESS_ONCE(a->close_lag),
+                (unsigned long long)ACCESS_ONCE(a->close_gate),
+                (unsigned long long)ACCESS_ONCE(a->close_by_steal),
+                (unsigned long long)ACCESS_ONCE(a->stolen_reads),
+                (unsigned long long)ACCESS_ONCE(a->stolen_max));
+
+            /* User RDTSCs in programs' own code, the only ones compressed */
+            if ( v->vcpu_id < RDTSC_PAIR_VCPUS )
+                printk(XENLOG_INFO
+                    "RDTSC_POC: dom=%u vcpu=%u prog_reads=%llu "
+                    "prog_compressed=%llu prog_far=%llu prog_slept=%llu "
+                    "prog_lag=%llu prog_pvclock=%llu prog_max_hidden=%llu "
+                    "prog_pure=%llu\n",
+                    d->domain_id, v->vcpu_id,
+                    (unsigned long long)prog[v->vcpu_id].reads,
+                    (unsigned long long)prog[v->vcpu_id].compressed,
+                    (unsigned long long)prog[v->vcpu_id].far,
+                    (unsigned long long)prog[v->vcpu_id].slept,
+                    (unsigned long long)prog[v->vcpu_id].lag,
+                    (unsigned long long)prog[v->vcpu_id].pvclock,
+                    (unsigned long long)prog[v->vcpu_id].max_hidden,
+                    (unsigned long long)prog[v->vcpu_id].pure);
+        }
+    }
+
+    rcu_read_unlock(&domlist_read_lock);
+}
+
+static bool __read_mostly opt_rdtsc_poc;
+boolean_param("rdtsc-poc", opt_rdtsc_poc);
+
 static bool __initdata opt_force_ept;
 boolean_param("force-ept", opt_force_ept);
 
+static void cf_check rdtsc_poc_enable(unsigned char key)
+{
+    if ( !ACCESS_ONCE(rdtsc_poc_apply_enabled) )
+    {
+        ACCESS_ONCE(rdtsc_poc_apply_enabled) = true;
+
+        printk(XENLOG_INFO "RDTSC_POC: compensation enabled\n");
+    }
+}
+
 static void cf_check vmx_ctxt_switch_from(struct vcpu *v);
 static void cf_check vmx_ctxt_switch_to(struct vcpu *v);
 
@@ -566,22 +1012,55 @@ static int cf_check vmx_domain_initialise(struct domain *d)
     };
     int rc;
 
+    struct vmx_domain *vmx = &d->arch.hvm.vmx;
+
     d->arch.ctxt_switch = &csw;
 
     /*
      * Work around CVE-2018-12207?  The hardware domain is already permitted
      * to reboot the system, so doesn't need mitigating against DoS's.
      */
-    d->arch.hvm.vmx.exec_sp = is_hardware_domain(d) || opt_ept_exec_sp;
+    vmx->exec_sp = is_hardware_domain(d) || opt_ept_exec_sp;
+
+    /*
+     * Only guests created with altp2m, the ones DRAKVUF analyses: every other one
+     * (a PVH service domain) would pay a VM exit per RDTSC for nothing.
+     * hvm_domain_initialise() has set the mode from the creation flags.
+     */
+    vmx->rdtsc_poc_enabled = opt_rdtsc_poc && !is_hardware_domain(d) &&
+        d->arch.hvm.params[HVM_PARAM_ALTP2M] != XEN_ALTP2M_disabled;
+    spin_lock_init(&vmx->rdtsc_lock);
 
