-    types_to_skip = ["LF_METHODLIST", "LF_SUBSTR_LIST", "LF_VTSHAPE"]
+    types_to_skip = ["LF_METHODLIST", "LF_SUBSTR_LIST", "LF_VTSHAPE", "LF_VFTABLE"]
 
     def consume_type(
         self, module: interfaces.context.ModuleInterface, offset: int, length: int
@@ -1005,8 +1005,16 @@ class PdbReader:
                 value = module.object(object_type="long", offset=offset)
             elif sub_leaf_type in [leaf_type.LF_ULONG]:
                 value = module.object(object_type="unsigned long", offset=offset)
+            elif sub_leaf_type in [leaf_type.LF_QUADWORD]:
+                value = module.object(object_type="long long", offset=offset)
